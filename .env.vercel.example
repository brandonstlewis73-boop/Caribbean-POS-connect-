# Add these in Vercel Project Settings -> Environment Variables.
# Use real values in Vercel only. Do not commit real secrets.

DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-DATABASE-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=no-verify
SUPABASE_DB_URL=
PGSSLMODE=require
SESSION_SECRET=replace-with-a-long-random-production-secret

NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-PUBLISHABLE-OR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

ADMIN_EMAIL=owner@yourbusiness.com
AI_SUPPORT_ENABLED=true
DEFAULT_COUNTRY_CODE=+1868
DEFAULT_COUNTRY=TT
GEOCODING_PROVIDER=fallback
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
SMS_PROVIDER=
EMAIL_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional legacy Stripe management only; new checkout uses PayPal.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# PayPal-only recurring subscription checkout (never expose secrets to the browser)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_STARTER_PLAN_ID=
PAYPAL_PREMIUM_PLAN_ID=
PAYPAL_PRO_PLAN_ID=
