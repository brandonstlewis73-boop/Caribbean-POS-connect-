# Supabase Postgres connection string.
# Local development can use the direct 5432 URI. Vercel/production should use the Supabase pooled URI.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:6543/postgres?pgbouncer=true
SUPABASE_DB_URL=
PGSSLMODE=require
SESSION_SECRET=change-this-to-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
ADMIN_EMAIL=admin@caribbeanpos.test
DEFAULT_WHATSAPP_NUMBER=4437582368
