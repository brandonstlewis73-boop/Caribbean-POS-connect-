# Supabase Postgres connection string.
# Use the transaction pooler for Vercel and for local networks where the direct 5432 host is IPv6-only/blocked.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-DATABASE-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=no-verify
SUPABASE_DB_URL=
PGSSLMODE=require
SESSION_SECRET=change-this-to-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
ADMIN_EMAIL=admin@demo.com
DEFAULT_WHATSAPP_NUMBER=4437582368
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
BUSINESS_WHATSAPP_NUMBER=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
